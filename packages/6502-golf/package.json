{
  "name": "6502-golf",
  "version": "1.0.0",
  "description": "6502 golfing website",
  "main": "src/index.ts",
  "scripts": {
    "build": "./node_modules/.bin/esbuild src/page.tsx --bundle --minify --sourcemap --outfile=dist/out.js && ./node_modules/.bin/esbuild src/leaderboard.tsx --bundle --minify --sourcemap --outfile=dist/leaderboard.js && ./node_modules/.bin/esbuild src/worker.ts --bundle --minify --sourcemap --platform=node --outfile=dist/worker.js && ./node_modules/.bin/esbuild src/index.ts --bundle --minify --sourcemap --platform=node --outfile=dist/index.js",
    "build_prod": "./node_modules/.bin/esbuild src/page.tsx --bundle --outfile=dist/out.js && ./node_modules/.bin/esbuild src/leaderboard.tsx --bundle --outfile=dist/leaderboard.js && ./node_modules/.bin/esbuild src/worker.ts --bundle --platform=node --outfile=dist/worker.js && ./node_modules/.bin/esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js",
    "start": "node --run build && node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "CatsAreFluffy",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.0",
    "@types/react-dom": "^19.2.2",
    "esbuild": "0.26.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.49.0"
  },
  "dependencies": {
    "@uiw/react-codemirror": "^4.25.3",
    "codemirror": "^6.0.2",
    "fluffy-6502": "^0.2.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "workerpool": "^10.0.1"
  }
}
